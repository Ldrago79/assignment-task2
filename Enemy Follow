AEnemyAIController::AEnemyController()
{
// Set up the perception component
AIPerceptionComponent = CreateDefaultSubobject<UAIPerceptionComponent>(TEXT("AIPerceptionCpmponent"));
AIPerceptionComponent->SetPerceptionUpdateRate(0.2f);  // Update perception every 0.2 seconds

// Set up sight sense 
UAISenseConfig_Sight* SightConfig = CreateDefaultSubobject<UAISenseConfig_Sight>(TEXT("SightConfig"));
SightConfig-> SightRadius = 1000.0f;
SightConfig->SightAngle = 120.0f;
SightConfig->LoseSightRadius = 1200.0f;
SightConfig-> PeripheralVisionAngle = 30.0f;
AIPerceptionComponent-> SetSenseConfig(SightConfig); 

// Set up hearing sense
UAISenseConfig_Hearing* HearingConfig = CreateDefaultSunobject<UAISense_Hearing>(TEXT("HearingConfig"));
HearingConfig->HearingRange = 1500.0f;
HearingConfig-> HearingSensitivity = 0.8f;
AIPerceptionComponent -> SetSenseConfig(HearingConfig);

// Set up smell sense
UAISenseConfig_Smell* SmellConfig = CreateDefaultSubobject<UAISenseConfig_Smell>(TEXT("SmelllConfig"));
SmellConfig->SmellRadius = 500.0f;
SmellConfig->LoseScentRate = 0.5f;
AIPerceptionComponent -> SetSenseConfig(SmellConfig);
}

void AEnemyAIController::OnPossess(APawn* InPawn)
{
Super::OnPossess(InPawn);
EnemyCharacter = Cast<AEnemyCharacter>(InPawn);
if(EnemyCharacter)
{

// Load behaviour tree
if(BehaviourTree)
{
RunBehaviourTree(BehaviourTree);
}

// Initialize blackboard values 
BlackboardComp-> SetValueAsObject(TEXT("SelfActor"), GetPawn());
BlackboardComp-> SetValueAsObject(TEXT("PlayerActor"), GetWorld()->GetFirstPlayerController()->GetPawn());
}
}

